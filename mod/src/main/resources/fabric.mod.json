{
  "schemaVersion": 1,
  "id": "sprinkleclient",
  "version": "${version}",
  "name": "Sprinkle Client",
  "description": "A Donut SMP themed client. Every button takes you to Donut SMP. Fan-made, not affiliated with DrDonut or Donut SMP.",
  "authors": ["DarkerDawnFR"],
  "license": "All-Rights-Reserved",
  "icon": "assets/sprinkleclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["fr.darkerdawn.sprinkle.SprinkleClient"],
    "voicechat": ["fr.darkerdawn.sprinkle.voice.DonutVoicePlugin"]
  },
  "mixins": ["sprinkleclient.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "${mc}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "voicechat": "*",
    "modmenu": "*"
  }
}
